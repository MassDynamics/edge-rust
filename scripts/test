#!/bin/bash
# The CI gate in the Rust image: cargo test (debug and release) and pytest against the committed
# small corpus tier (tests/corpus-small, built by scripts/build_small_corpus.py). The full count
# corpus (~780 MB, outside git) stays the local gate: without MD_COUNT_CORPUS_DIR the tests read
# ~/wd/md-count-golden-corpus.
# Usage: scripts/test
set -e
REPO=$(cd "$(dirname "$0")/.." && pwd)
export COPYFILE_DISABLE=1   # macOS tar: no AppleDouble ._ files in the stream
RUST_IMAGE=rust:1.95.0      # keep equal to rust-toolchain.toml
UV_VERSION=0.12.6

echo "--- :rust: cargo test (debug + release), pytest"
git -C "$REPO" ls-files -z | tar -C "$REPO" --null -T - -cf - \
  | docker run -i --rm --platform linux/amd64 \
    -e MD_COUNT_CORPUS_DIR=/work/tests/corpus-small "$RUST_IMAGE" sh -c \
    "mkdir /work && cd /work && tar -xf - \
     && cargo test --workspace --locked && cargo test --workspace --release --locked \
     && curl -LsSf https://astral.sh/uv/$UV_VERSION/install.sh | sh \
     && ~/.local/bin/uv run pytest -q"
